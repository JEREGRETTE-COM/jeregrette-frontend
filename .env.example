# Public site origin, used for metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel backend. HTTPS only: the host answers plain HTTP with a 301, which
# would send credentials in clear on the first hop.
API_URL=https://jeregrette-api.benrango.com/api
\n# Mettre à 1 quand POST /users/me/avatar existe côté backend\nAVATAR_UPLOAD=0\n
# Reverb (Laravel Echo / WebSocket), for live notifications. Leave empty to
# fall back to a 30 s refresh.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
